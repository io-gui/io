{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "inlineSources": true,
    "strict": true,
    "strictNullChecks": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noUnusedLocals": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "noImplicitOverride": true
  },
  "files": [],
  "references": [
    { "path": "./packages/core" },
    { "path": "./packages/icons" },
    { "path": "./packages/inputs" },
    { "path": "./packages/sliders" },
    { "path": "./packages/colors" },
    { "path": "./packages/menus" },
    { "path": "./packages/navigation" },
    { "path": "./packages/editors" },
    { "path": "./packages/layout" },
    { "path": "./packages/markdown" },
    { "path": "./packages/three" }
  ]
}
