{
  "name": "io-gui-workspace",
  "version": "2.0.0-alpha.2",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.5.0",
  "scripts": {
    "dev": "vite",
    "build": "pnpm lint && pnpm clean && tsc -b",
    "build:watch": "tsc -b -w",
    "bundle": "pnpm build && node bundle.js",
    "docs:api": "typedoc",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "test": "vitest run --project unit",
    "test:core": "vitest run --project unit packages/core",
    "test:colors": "vitest run --project unit packages/colors",
    "test:editors": "vitest run --project unit packages/editors",
    "test:icons": "vitest run --project unit packages/icons",
    "test:inputs": "vitest run --project unit packages/inputs",
    "test:layout": "vitest run --project unit packages/layout",
    "test:markdown": "vitest run --project unit packages/markdown",
    "test:menus": "vitest run --project unit packages/menus",
    "test:navigation": "vitest run --project unit packages/navigation",
    "test:sliders": "vitest run --project unit packages/sliders",
    "test:three": "vitest run --project unit packages/three",
    "test:coverage": "vitest run --project coverage --coverage",
    "bench": "vitest bench --project bench --compare ./benchmarks/results.json --outputJson ./benchmarks/results.json",
    "clean": "rm -rf packages/**/dist packages/**/tsconfig.tsbuildinfo"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-strip": "^3.0.4",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^25.6.0",
    "@vitest/browser-playwright": "^4.1.4",
    "@vitest/coverage-v8": "4.1.4",
    "@vitest/ui": "4.1.4",
    "eslint": "^10.2.0",
    "playwright": "^1.59.1",
    "terser": "^5.46.1",
    "typedoc": "^0.28.17",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.8",
    "vitest": "^4.1.4"
  }
}
