{
  "name": "io-gui-workspace",
  "version": "2.0.0-alpha.5",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.5.0",
  "scripts": {
    "dev": "vite",
    "build": "pnpm lint && pnpm clean && tsc -b",
    "build:watch": "tsc -b -w",
    "bundle": "pnpm build && node bundle.js",
    "docs:api": "typedoc",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "test": "vitest run --project unit",
    "coverage": "vitest run --project coverage --coverage",
    "bench": "vitest bench --run --no-file-parallelism --reporter=json --outputFile=./benchmarks/results.json",
    "bench:baseline": "vitest bench --run --no-file-parallelism --reporter=json --outputFile=./benchmarks/results-baseline.json",
    "clean": "rm -rf packages/**/dist packages/**/tsconfig.tsbuildinfo"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-strip": "^3.0.4",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^26.6.4",
    "@vitest/browser-playwright": "5.0.3",
    "@vitest/coverage-v8": "5.0.3",
    "@vitest/ui": "5.0.3",
    "eslint": "^10.12.0",
    "playwright": "^1.64.0",
    "terser": "^5.51.2",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "5.0.3"
  }
}
