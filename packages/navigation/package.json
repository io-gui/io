{
  "name": "@io-gui/navigation",
  "version": "2.0.0-alpha.3",
  "description": "A set of navigators for Io-Gui.",
  "sideEffects": [
    "**/elements/**",
    "**/nodes/**"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/io-gui/io.git"
  },
  "keywords": [
    "ui",
    "io",
    "gui",
    "iogui",
    "io-navigation"
  ],
  "author": "Aleksandar (Aki) Rodic",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/io-gui/io/issues"
  },
  "homepage": "https://iogui.dev",
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@9.5.0",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "/dist/",
    "/LICENSE",
    "/README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "devDependencies": {
    "@io-gui/core": "workspace:*",
    "@io-gui/menus": "workspace:*",
    "@io-gui/inputs": "workspace:*",
    "@io-gui/icons": "workspace:*"
  },
  "peerDependencies": {
    "@io-gui/core": "^2.0.0-alpha.3",
    "@io-gui/menus": "^2.0.0-alpha.3",
    "@io-gui/inputs": "^2.0.0-alpha.3",
    "@io-gui/icons": "^2.0.0-alpha.3"
  }
}
