{
  "name": "@io-gui/three",
  "version": "2.0.0-alpha.4",
  "description": "Three.js UI elements built with io-gui",
  "sideEffects": [
    "**/elements/**",
    "**/nodes/**",
    "**/configs/**"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/io-gui/io.git"
  },
  "keywords": [
    "ui",
    "io",
    "gui",
    "iogui",
    "md",
    "three",
    "io-three"
  ],
  "author": "Aleksandar (Aki) Rodic",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/io-gui/io/issues"
  },
  "homepage": "https://iogui.dev",
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@9.5.0",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "/dist/",
    "/LICENSE",
    "/README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "devDependencies": {
    "@io-gui/core": "workspace:*",
    "@io-gui/layout": "workspace:*",
    "@io-gui/menus": "workspace:*",
    "@io-gui/editors": "workspace:*",
    "@io-gui/inputs": "workspace:*",
    "@io-gui/sliders": "workspace:*",
    "@io-gui/colors": "workspace:*",
    "@types/three": "^0.182.0",
    "three": "^0.182.0"
  },
  "peerDependencies": {
    "@io-gui/core": "^2.0.0-alpha.4",
    "@io-gui/layout": "^2.0.0-alpha.4",
    "@io-gui/menus": "^2.0.0-alpha.4",
    "@io-gui/editors": "^2.0.0-alpha.4",
    "@io-gui/inputs": "^2.0.0-alpha.4",
    "@io-gui/sliders": "^2.0.0-alpha.4",
    "@io-gui/colors": "^2.0.0-alpha.4",
    "three": ">=0.182.0"
  }
}
