{
  "name": "@io-gui/markdown",
  "version": "2.0.0-alpha.2",
  "description": "Markdown viewer for Io-Gui.",
  "sideEffects": [
    "**/elements/**",
    "**/nodes/**"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/io-gui/io.git"
  },
  "keywords": [
    "ui",
    "io",
    "gui",
    "iogui",
    "md",
    "markdown",
    "io-markdown"
  ],
  "author": "Aleksandar (Aki) Rodic",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/io-gui/io/issues"
  },
  "homepage": "https://iogui.dev",
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@9.5.0",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "/src/",
    "/dist/",
    "/LICENSE",
    "/README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "dompurify": "3.4.0",
    "marked": "18.0.0",
    "marked-highlight": "2.2.4"
  },
  "devDependencies": {
    "@io-gui/core": "workspace:*"
  },
  "peerDependencies": {
    "@io-gui/core": "^2.0.0-alpha.2"
  }
}
